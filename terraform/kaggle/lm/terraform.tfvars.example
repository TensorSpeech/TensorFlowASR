# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored because the API key
# below is a live credential -- check that `git status` never lists it before committing.
#
#   cp terraform.tfvars.example terraform.tfvars

# --- Kaggle account -------------------------------------------------------
kaggle_username = "your-kaggle-username"
kaggle_key      = "your-kaggle-api-key" # https://www.kaggle.com/settings -> Create New Token

# --- The notebook ---------------------------------------------------------
# The slug doubles as the title, so it needs at least 5 characters.
kernel_slug = "tensorflowasr-train-lm"
is_private  = true

# `accelerator` picks the hardware; `device_type` is what TensorFlow is told to use. A
# precondition rejects a mismatch rather than letting the kernel train on the CPU in silence.
accelerator = "NvidiaTeslaP100" # or NvidiaTeslaT4, NvidiaL4, ...
device_type = "gpu"

# For a TPU instead -- read the TPU section of the README first, none of it has run on real
# hardware, and an LSTM is a poor fit for a TPU to begin with:
# accelerator = "TpuV5E8"
# device_type = "tpu"
# tpu_address = "local"     # TPU VM: the chips are on this machine
# tpu_vm      = true
# bs          = 32          # per replica -- 8 cores means a global batch of 256
# learning_rate = 2.5e-3    # global batch is 8x larger, so scale the rate up

# Datasets to mount. Each shows up at /kaggle/input/<dataset-slug>.
dataset_sources = [
  "your-username/librispeech-train-clean-100",
]

# --- Code -----------------------------------------------------------------
# repo_ref must be a pushed branch that has tensorflow_asr/scripts/train_lm.py and
# tensorflow_asr/models/lm/. That is not main today.
repo_url = "https://github.com/TensorSpeech/TensorFlowASR.git"
repo_ref = "feat/beamsearch"

# --- Config and data ------------------------------------------------------
# A config inside the repository...
config_path = "examples/models/transducer/conformer/small.yml.j2"
# ...or one from this machine, embedded into the notebook (wins over config_path):
# config_file = "../../../examples/models/transducer/conformer/small.yml.j2"

datadir  = "/kaggle/input/librispeech-train-clean-100"
modeldir = "/kaggle/working/model"

# The example configs interpolate these through jinja. An undefined one renders empty
# rather than failing, so a missing entry usually shows up as a half-formed path.
extra_args = [
  # "--vocabprefix=/kaggle/input/librispeech-vocab/sp",
  # "--vocabsize=1000",
]

# --- Which trainer to run -------------------------------------------------
# The subcommand picks which language model is built. Each reads its own dataset from the config's
# data_config.lm_dataset_config -- its data_paths, max_length and max_lines are dataset settings
# there, not terraform variables.
#
# train_internal_lm -> lm_config.internal_config, the bigram LODR subtracts. Counts the ASR
#                      transcripts (internal_dataset_config), so bs/epochs/learning_rate do nothing.
trainer = "train_internal_lm"

# train_external_lm -> lm_config.external_config, the LM fused in. Gradient descent on a big corpus
# (external_dataset_config, e.g. librispeech-lm-norm.txt.gz):
# trainer         = "train_external_lm"
# bs              = 128
# epochs          = 1
# lr_schedule     = "constant"   # or "cosine", if epochs x steps_per_epoch is a budget you finish
# steps_per_epoch = 7813         # REQUIRED for this trainer; it will not read the corpus to guess.
#   One full pass is ceil(sequences / (bs x replicas)): `wc -l` the corpus (or `zcat corpus.gz |
#   wc -l`) for the count, replicas is 8 on a TPU and 1 everywhere else. With
#   lm_dataset_config.external_dataset_config.max_lines = 1000000 and bs = 128 on one GPU that is
#   ceil(1000000 / 128) = 7813.

# train_kenlm -> a KenLM n-gram, the cheap alternative external LM. Needs the kenlm/lmplz binary.
# trainer   = "train_kenlm"
# max_lines = 1000000        # cap the corpus; null reads all
# prune     = [0, 0, 1]      # KenLM pruning per order; [] prunes nothing

# --- What apply does after pushing ---------------------------------------
# Default is false: push and return, then watch it with `terraform output status_command`.
# true makes `terraform apply` block until the run finishes, which can be hours, and
# download the weights itself.
wait_for_completion = false
timeout_minutes     = 720
download_output     = true
