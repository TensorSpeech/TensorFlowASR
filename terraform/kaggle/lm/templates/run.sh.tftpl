#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# TensorFlowASR -- train a language model on Kaggle.
#
# Generated by Terraform from terraform/kaggle/lm. This is the whole run: the
# notebook is a single cell that only writes this file out and executes it.
# Editing it on Kaggle is pointless -- the next `terraform apply` overwrites the
# notebook that carries it. Change the tfvars and re-apply instead.
# ---------------------------------------------------------------------------
set -euo pipefail

REPO_URL="${repo_url}"
REPO_REF="${repo_ref}"
REPO_DIR="${repo_dir}"
INSTALL_TARGET="${install_target}"
DATADIR="${datadir}"
MODELDIR="${modeldir}"
DEVICE_TYPE="${device_type}"
TRAINER="${trainer}"

mkdir -p "$MODELDIR"

# --- repository -----------------------------------------------------------
# Cloned outside /kaggle/working on purpose: everything there is collected as notebook
# output, so a clone would be dragged into every `kaggle kernels output` download.
if [ -d "$REPO_DIR/.git" ]; then
  git -C "$REPO_DIR" fetch --depth 1 origin "$REPO_REF"
  git -C "$REPO_DIR" checkout -f FETCH_HEAD
else
  git clone --depth 1 --branch "$REPO_REF" "$REPO_URL" "$REPO_DIR"
fi
git -C "$REPO_DIR" --no-pager log -1 --oneline

# --- dependencies ---------------------------------------------------------
# uv resolves the same wheels as pip but far faster, which matters on a time-boxed session.
# Kaggle does not ship it, so bootstrap it with pip.
command -v uv >/dev/null 2>&1 || python -m pip install -q uv
uv --version

# --system installs into the real interpreter rather than a .venv uv might otherwise adopt
# near the working directory. INSTALL_TARGET carries the accelerator extra: `.[cuda]` on a
# GPU box is what pulls tensorflow[and-cuda]; a plain `.` install sees no GPU and trains on
# the CPU, happily and far too slowly to finish.
PYTHON="$(command -v python)"
( cd "$REPO_DIR" && uv pip install --system --python "$PYTHON" -q -e "$INSTALL_TARGET" )

# The TPU build replaces stock TensorFlow rather than sitting beside it -- both ship a
# `tensorflow` distribution, so no extra can express it. scripts/install_tpu.sh does the
# uninstall-then-install, reading the version off the TensorFlow it replaces so they cannot drift.
if [ "$DEVICE_TYPE" = "tpu" ]; then
  "$REPO_DIR/scripts/install_tpu.sh" --system --python "$PYTHON"
fi

# --- device sanity check --------------------------------------------------
if [ "$DEVICE_TYPE" = "gpu" ]; then
  # A GPU is registered at import, so an empty list here really means no GPU. Fail now rather
  # than hours into a run that turned out to be on the CPU.
  python - <<'PY'
import tensorflow as tf
gpus = tf.config.list_physical_devices("GPU")
print("TensorFlow", tf.__version__, "| visible GPUs:", gpus)
if not gpus:
    raise SystemExit(
        "device_type is 'gpu' but TensorFlow sees no GPU. Check that `accelerator` in the "
        "tfvars is an Nvidia* ID -- that is what installs the .[cuda] extra."
    )
PY
elif [ "$DEVICE_TYPE" = "tpu" ]; then
  # initialize_tpu_system (inside the trainer) is what creates the TPU devices, so they are
  # invisible until then and an empty list here proves nothing. Just report what can be seen.
  python - <<'PY'
import glob, os
import tensorflow as tf
print("TensorFlow", tf.__version__)
print("Physical TPU devices:", tf.config.list_physical_devices("TPU"), "(expected empty until init)")
print("TPU device nodes:", sorted(glob.glob("/dev/accel*")) or "none found")
print("TPU env:", {k: v for k, v in sorted(os.environ.items()) if k.startswith(("TPU", "LIBTPU", "XLA", "PJRT"))} or "none set")
PY
fi

# --- config ---------------------------------------------------------------
# Jinja imports inside the config resolve against the clone (file_util.load_yaml builds a
# FileSystemLoader over --repodir), which is why the repo must be present even for an embedded
# config. An embedded config arrives base64-encoded so no quoting or `$` inside it can break
# this script.
CONFIG_B64="${config_b64}"
if [ -n "$CONFIG_B64" ]; then
  CONFIG_PATH="/kaggle/working/config.yml.j2"
  printf '%s' "$CONFIG_B64" | base64 -d > "$CONFIG_PATH"
else
  CONFIG_PATH="$REPO_DIR/${config_path}"
fi
[ -f "$CONFIG_PATH" ] || { echo "Config not found: $CONFIG_PATH" >&2; exit 1; }
echo "----------------------------------------------------------------------"
echo "config: $CONFIG_PATH"
cat "$CONFIG_PATH"
echo "----------------------------------------------------------------------"

# Kaggle mounts each attached dataset at /kaggle/input/<dataset-slug>; datadir must point there.
[ -d "$DATADIR" ] || { echo "Dataset directory not found: $DATADIR (check dataset_sources / datadir)" >&2; exit 1; }
ls -la "$DATADIR"

%{ if kaggle_model_handle != "" ~}
# --- checkpoint credentials -----------------------------------------------
# SECURITY: the next two lines are your real Kaggle API token, written here by Terraform. It
# therefore exists in terraform.tfstate, build/run.sh, build/notebook.ipynb and the notebook
# Kaggle stores -- keep is_private = true, and rotate it at kaggle.com/settings if any of those
# leak. Kaggle Secrets would keep it off disk but cannot be automated: no Kaggle API creates or
# attaches one. Exported before `set -x` so they are never echoed.
export KAGGLE_USERNAME=${kaggle_username}
export KAGGLE_KEY=${kaggle_key}
# Route model_download through the REST API rather than the notebook data proxy: the proxy answers
# a not-yet-existing model -- every first run -- with a generic error the restore path mistakes for
# a real failure, killing the run before the first step. REST returns a clean 404 = "nothing to
# restore yet", and reads the private model on later runs.
export DISABLE_KAGGLE_CACHE=1

%{ endif ~}
# --- train ----------------------------------------------------------------
# Which language model is built is the subcommand, not a flag. All three write under
# <modeldir>/lm. The dataset -- data_paths, max_length, max_lines -- lives in the config's
# data_config.lm_dataset_config (internal_dataset_config / external_dataset_config), not here.
set -x
tensorflow_asr "$TRAINER" \
  --config-path="$CONFIG_PATH" \
  --datadir="$DATADIR" \
  --modeldir="$MODELDIR" \
  --repodir="$REPO_DIR" \
  ${train_flags}
{ set +x; } 2>/dev/null

echo "Done. Language model artifacts under $MODELDIR/lm:"
ls -lh "$MODELDIR/lm" || true
