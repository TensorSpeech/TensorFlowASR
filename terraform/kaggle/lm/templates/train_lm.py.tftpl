# %%
# ---------------------------------------------------------------------------
# TensorFlowASR -- train a beam search language model.
#
# Generated by Terraform from terraform/kaggle/lm. Editing this notebook on
# Kaggle is pointless: the next `terraform apply` overwrites it. Change the
# tfvars and re-apply instead.
# ---------------------------------------------------------------------------
import os
import shlex
import shutil
import subprocess
import sys

REPO_URL = "${repo_url}"
REPO_REF = "${repo_ref}"
REPO_DIR = "${repo_dir}"
DATADIR = "${datadir}"
MODELDIR = "${modeldir}"
OUTPUT = "${output_path}"
DEVICE_TYPE = "${device_type}"


def run(cmd, cwd=None):
    """Run a command, stream its output, and fail the cell if it exits non-zero."""
    print("$", shlex.join(cmd), flush=True)
    subprocess.run(cmd, cwd=cwd, check=True)


os.makedirs(os.path.dirname(OUTPUT), exist_ok=True)
os.makedirs(MODELDIR, exist_ok=True)

# %%
# Cloned outside /kaggle/working on purpose: everything under /kaggle/working is
# collected as notebook output, so a clone there would be dragged into every
# `kaggle kernels output` download.
if os.path.isdir(os.path.join(REPO_DIR, ".git")):
    run(["git", "-C", REPO_DIR, "fetch", "--depth", "1", "origin", REPO_REF])
    run(["git", "-C", REPO_DIR, "checkout", "-f", "FETCH_HEAD"])
else:
    run(["git", "clone", "--depth", "1", "--branch", REPO_REF, REPO_URL, REPO_DIR])

run(["git", "-C", REPO_DIR, "--no-pager", "log", "-1", "--oneline"])

# %%
# uv resolves the same dependencies as pip but far faster, which matters when the whole
# session is time-boxed. Kaggle does not ship it, so bootstrap it with pip first.
if shutil.which("uv") is None:
    run([sys.executable, "-m", "pip", "install", "-q", "uv"])

run(["uv", "--version"])

# `--system` installs into a real interpreter rather than a virtualenv, and the explicit
# `--python` pins which one: uv otherwise adopts any .venv it finds near the working
# directory, and packages would land somewhere this notebook cannot import from.
#
# The target carries the accelerator extra -- `.[cuda]` on a GPU kernel, which is what pulls
# tensorflow[and-cuda] and the nvidia wheels. Installing plain `.` on a GPU box gives you a
# TensorFlow that runs, sees no device, and quietly trains on the CPU.
ENV_FLAGS = ["--system", "--python", sys.executable]

run(["uv", "pip", "install"] + ENV_FLAGS + ["-q", "-e", "${install_target}"], cwd=REPO_DIR)

# The TPU build has to replace the stock TensorFlow rather than sit beside it -- both ship a
# `tensorflow` distribution and `tensorflow` is a base dependency, so no extra can express it.
# `scripts/install_tpu.sh` in the repository does the uninstall-then-install, and lives there
# rather than here so the same command works outside a notebook. It reads the version off the
# TensorFlow it is replacing, so the two cannot drift.
if DEVICE_TYPE == "tpu":
    run([os.path.join(REPO_DIR, "scripts", "install_tpu.sh")] + ENV_FLAGS)

import glob  # noqa: E402

import tensorflow as tf  # noqa: E402

print("TensorFlow", tf.__version__)

if DEVICE_TYPE == "gpu":
    # A GPU is registered at import, so an empty list here really does mean no GPU. Fail now
    # rather than hours into a run that turned out to be on the CPU: a GPU kernel with a CPU-only
    # TensorFlow trains perfectly happily, just far too slowly to finish.
    gpus = tf.config.list_physical_devices("GPU")
    print("Visible GPUs:", gpus)
    if not gpus:
        raise SystemExit(
            "device_type is \"gpu\" but TensorFlow sees no GPU.\n"
            "Check that `accelerator` in the tfvars is an Nvidia* ID -- that is what installs "
            "the .[cuda] extra, and therefore tensorflow[and-cuda]."
        )

elif DEVICE_TYPE == "tpu":
    # A TPU is different: `tf.tpu.experimental.initialize_tpu_system` is what creates the devices,
    # so `list_physical_devices("TPU")` is empty until then and an empty list here proves nothing.
    # Initialising would take exclusive hold of the chips, and train_lm runs in a subprocess that
    # has to do that itself -- so this reports what can be seen without claiming the TPU, and
    # train_lm is left as the authority on whether the TPU actually works.
    print("Physical TPU devices:", tf.config.list_physical_devices("TPU"), "(expected empty until initialize_tpu_system runs)")
    print("TPU device nodes:", sorted(glob.glob("/dev/accel*")) or "none found")
    print("TPU env:", {k: v for k, v in sorted(os.environ.items()) if k.startswith(("TPU", "LIBTPU", "XLA", "PJRT"))} or "none set")
    run([sys.executable, "-m", "pip", "show", "tensorflow-tpu", "libtpu"])

# %%
# The config is jinja2 and its imports resolve against `repodir` (see
# file_util.load_yaml, which builds a FileSystemLoader over it). That is why
# --repodir points at the clone below, and why the repository has to be present
# even when the config itself is embedded from outside it.
CONFIG_INLINE = ${config_inline}

if CONFIG_INLINE is None:
    CONFIG_PATH = os.path.join(REPO_DIR, "${config_path}")
else:
    CONFIG_PATH = "/kaggle/working/config.yml.j2"
    with open(CONFIG_PATH, "w", encoding="utf-8") as handle:
        handle.write(CONFIG_INLINE)

if not os.path.isfile(CONFIG_PATH):
    raise SystemExit("Config not found: " + CONFIG_PATH)

print(CONFIG_PATH)
print("-" * 70)
with open(CONFIG_PATH, encoding="utf-8") as handle:
    print(handle.read())

# %%
if not os.path.isdir(DATADIR):
    raise SystemExit(
        "Dataset directory not found: "
        + DATADIR
        + "\nKaggle mounts each attached dataset at /kaggle/input/<dataset-slug>."
        + " Check `dataset_sources` and `datadir` in the tfvars."
    )

run(["ls", "-la", DATADIR])

# %%
cmd = [
    "tensorflow_asr",
    "train_lm",
    "--config-path=" + CONFIG_PATH,
    "--repodir=" + REPO_DIR,
    "--datadir=" + DATADIR,
    "--modeldir=" + MODELDIR,
    "--output=" + OUTPUT,
    "--dataset-type=${dataset_type}",
    "--target=${target}",
    "--bs=${bs}",
    "--epochs=${epochs}",
    "--steps-per-epoch=${steps_per_epoch}",
    "--max-length=${max_length}",
    "--learning-rate=${learning_rate}",
    "--device-type=${device_type}",
    "--mxp=${mxp}",
    "--verbose=2",
]
cmd += ${extra_flags}

%{ if kaggle_model_handle != "" ~}
# %%
# Checkpointing to a Kaggle model needs write credentials, and this notebook has none by
# default. Kaggle's implicit auth is a read-only data proxy: it serves `model_download` for
# public models and cannot create a model version at all.
#
# SECURITY: the two lines below are your real API token, written here by Terraform from the
# tfvars. It therefore exists in terraform.tfstate, in build/notebook.ipynb, and in the copy of
# this notebook Kaggle stores -- keep `is_private = true`, and rotate the token at
# https://www.kaggle.com/settings if any of those get out.
#
# The alternative is Kaggle Secrets (Add-ons -> Secrets), which keeps the token off disk, but it
# cannot be automated: no Kaggle API can create or attach a secret. This cell disappears when
# kaggle_model_handle is unset.
os.environ["KAGGLE_USERNAME"] = ${kaggle_username}
os.environ["KAGGLE_KEY"] = ${kaggle_key}

# Send `model_download` through the REST API rather than the notebook data proxy. The proxy is
# chosen automatically inside a notebook and answers a model that does not exist yet -- every
# first run -- with a generic {"errors":["Internal error"],"error":{"code":13}}, which arrives
# as kagglehub BackendError. The restore path only recognises the REST 404, so that error
# escapes and kills the run before the first step. The REST client returns a real 404, which is
# understood as "nothing to restore yet", and it can read the private model on later runs.
os.environ["DISABLE_KAGGLE_CACHE"] = "1"

%{ endif ~}
run(cmd)

# %%
print("Wrote", OUTPUT, os.path.getsize(OUTPUT), "bytes")
run(["ls", "-lh", os.path.dirname(OUTPUT)])
